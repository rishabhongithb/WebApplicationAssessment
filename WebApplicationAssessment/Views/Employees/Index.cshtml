@model IEnumerable<WebApplicationAssessment.Models.Employee>

@{
    ViewData["Title"] = "Employee List";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Employee List</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add New Employee</a>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Date of Birth</th>
                <th>Phone Number</th>
                <th>Assigned Skills</th>
                <th style="width: 180px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        No employees found. Click <strong>+ Add New Employee</strong> to create one.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>@item.DateOfBirth.ToString("dd-MM-yyyy")</td>
                        <td>@item.Phone</td>
                        <td>
                            @if (item.Skills != null && item.Skills.Any())
                            {
                                @foreach (var skill in item.Skills)
                                {
                                    <span class="badge bg-primary me-1">@skill.Name</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">No Skills Assigned</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>

                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete @item.FirstName @item.LastName?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>